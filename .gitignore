# JobPilot repository-level ignores.
# Personal job-search data, credentials, and dependencies must never be committed.

# --- Secrets and Credentials ------------------------------------------------
.env
.env.*
!.env.example
*.local
credentials.json
*-credentials.json
service-account*.json
client_secret*.json
secrets/
backend/secrets/

# --- Personal Data ----------------------------------------------------------
dataset/
backend/data/
*.csv

# --- Frontend & Node.js -----------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
.vite/
*.tsbuildinfo

# --- Python & Virtual Environments -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
backend/.venv/
venv/
env/
ENV/
build/
*.egg-info/

# --- Testing & Tooling ------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors & OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
