# ---------------------------------------------------------------------------
# JobPilot backend - local configuration template
#
# Copy this file to `.env` in the SAME folder and fill in real values:
#     Copy-Item .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_NAME="JobPilot API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# --- Data source -----------------------------------------------------------
# csv           -> read the local CSV exports in DATA_DIR (default, works offline)
# google_sheets -> read the live spreadsheet in READ-ONLY mode
DATA_SOURCE=google_sheets

# Folder holding applications.csv and job_openings.csv (CSV mode only).
# Relative paths are resolved from the backend/ folder.
DATA_DIR=data

# --- Google Sheets (only used when DATA_SOURCE=google_sheets) ---------------
# The spreadsheet ID is the long string in the URL between /d/ and /edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to the service-account JSON key downloaded from Google Cloud.
# Keep it on the backend machine only; never send it to the frontend and
# never commit it.
GOOGLE_APPLICATION_CREDENTIALS=secrets/credentials.json

# Tab (worksheet) names. The existing Applications tab may still be called
# "Sheet1" - set that here. The backend never renames a tab.
GOOGLE_SHEETS_APPLICATIONS_TAB=Sheet1
GOOGLE_SHEETS_JOBS_TAB=Sheet2

# How long a Sheets read is reused before refetching. Set 0 to disable caching
# and read fresh on every request.
SHEETS_CACHE_TTL_SECONDS=300

# How many times a transient Sheets read (quota / network) is retried.
SHEETS_READ_RETRY_ATTEMPTS=2

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins (React dev server).
CORS_ORIGINS=http://localhost:3000

# --- Pagination ------------------------------------------------------------
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200