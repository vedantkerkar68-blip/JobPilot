# ---------------------------------------------------------------------------
# JobPilot frontend configuration
#
# Copy this file to `.env` in the SAME folder if you want to override defaults:
#     copy .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put a secret in this file.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, WITHOUT a trailing slash.
#
#   (empty)                 -> RECOMMENDED. The app calls the same origin it is
#                              served from (`/api/...`) and the Vite dev and
#                              preview servers proxy `/api` to 127.0.0.1:8000.
#                              No CORS involvement, works on any port.
#
#   http://127.0.0.1:8000   -> the browser calls the backend directly. This
#                              requires the frontend origin to be listed in the
#                              backend's CORS_ORIGINS. It works for the dev
#                              server (port 3000 is already the backend
#                              default) but NOT for `npm run preview` (port
#                              4173) unless you add that origin in backend/.env.
#
# Leaving this empty is the safe default and needs no backend changes.
VITE_API_BASE_URL=
